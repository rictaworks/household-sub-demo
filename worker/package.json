{
  "name": "household-sub-demo-worker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787 --var APP_ENV:development",
    "typecheck": "tsc --noEmit",
