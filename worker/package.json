    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply household_sub_demo --local",
    "deploy": "wrangler deploy --env production"
  },
  "dependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^22.20.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  }
}
